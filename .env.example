# Public routing
PUBLIC_HOST=relay.example.com
SRT_PORT=8890
PROXY_NETWORK=caddy

# Generate unique values; never commit a populated .env file.
SESSION_SECRET=generate-a-long-random-value
BOOTSTRAP_TOKEN=generate-a-one-time-setup-code
FERNET_KEY=generate-a-fernet-key
MEDIA_INTERNAL_USER=generate-an-internal-username
MEDIA_INTERNAL_PASS=generate-an-internal-password

# Optional Twitch OAuth integration for outage ads.
# Redirect URI: https://${PUBLIC_HOST}/api/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=
